# ---------------------------------------------------------------------------
# PBY Queue configuration. Copy to .env and fill in.
# ---------------------------------------------------------------------------

# Required to create events (the "Admin password" field on the New event screen).
# Use a long random value: whoever knows it can create events and, with Twilio set up,
# send texts at your cost. The placeholder below is refused, so creating events stays off
# until you change it.
ADMIN_PASSWORD=change-me-to-something-long

# Public base URL used in texted status links and the QR code. Keep the host short
# (25 chars or less) so links fit in one SMS. Also used to validate Twilio webhooks.
PUBLIC_URL=https://q.example.com

# Port inside the container (map it with HOST_PORT in docker-compose.yml).
PORT=3000
# Host port published by docker compose.
HOST_PORT=3000

# SQLite file. The Docker image stores it in the /data volume.
DATABASE_PATH=/data/pby-queue.db

# How many reverse-proxy hops to trust for X-Forwarded-* (default 1, e.g. Cloudflare Tunnel;
# `true` also means 1). Use 2 behind two proxies, an IP/CIDR list, or false when clients
# reach the app directly: a trusted header lets clients forge their IP and skip rate limits.
TRUST_PROXY=1

# Session cookie Secure flag: auto (Secure when the request is HTTPS), true or false.
COOKIE_SECURE=auto

# Data retention: days after an event closes before guest data is purged (default 7),
# and hours of host inactivity before an open event closes itself (default 12).
RETENTION_DAYS=7
AUTO_CLOSE_HOURS=12

# Salt for opt-out hashes (SHA-256 of phone + salt). Generated and stored in the
# database when unset; set it only if you need it stable across fresh databases.
# OPTOUT_SALT=

# Log level: fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=info

# ---- Twilio (optional). Leave blank for tap-to-send only. -----------------
# When set, the "Automatic" texting option appears in event settings.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either a sending number in E.164 (+18885551234) or a Messaging Service SID.
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
